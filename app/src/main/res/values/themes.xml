<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DeskPet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <!-- A normal Activity window owns the IME/focus and lifecycle.
         Unlike a focusable TYPE_APPLICATION_OVERLAY ComposeView this behaves
         consistently on HarmonyOS and survives keyboard resize. -->
    <style name="Theme.DeskPet.PetChat" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
